{
  "$schema": "https://raw.githubusercontent.com/tokens-studio/figma-plugin/main/packages/tokens-studio-for-figma/src/schemas/tokens.json",
  "name": "icrmahin Signature Brand Color System",
  "version": "1.0.0",
  "author": "A. Mahin (icrmahin@gmail.com)",
  "description": "Portable, contrast-audited design tokens for websites, mobile apps, dashboards, and developer tooling.",
  "color": {
    "foundation": {
      "light": {
        "value": "#F5EDE2",
        "type": "color",
        "description": "Primary light canvas background (Warm Parchment)"
      },
      "light-elevated": {
        "value": "#FAF5EE",
        "type": "color",
        "description": "Elevated card surface on light canvas"
      },
      "dark": {
        "value": "#201D19",
        "type": "color",
        "description": "Primary dark canvas foundation (Deep Espresso)"
      },
      "dark-elevated": {
        "value": "#292621",
        "type": "color",
        "description": "Elevated dark card surface / primary text"
      }
    },
    "surface": {
      "light": {
        "soft": { "value": "#EAE1D5", "type": "color", "description": "Secondary soft surface" },
        "muted": { "value": "#DFD4C6", "type": "color", "description": "Hover and elevated surface" }
      },
      "dark": {
        "soft": { "value": "#292621", "type": "color", "description": "Dark card container" },
        "muted": { "value": "#35312B", "type": "color", "description": "Dark secondary inset" },
        "hover": { "value": "#423D36", "type": "color", "description": "Dark hover state" }
      }
    },
    "typography": {
      "light": {
        "primary": { "value": "#292621", "type": "color", "description": "Headings and body on light (12.6:1 AAA)" },
        "secondary": { "value": "#666159", "type": "color", "description": "Subtitles and secondary text (5.4:1 AA)" },
        "muted": { "value": "#7E7870", "type": "color", "description": "Timestamps, metadata, tags (3.7:1 AA Large)" },
        "subtle": { "value": "#9E978D", "type": "color", "description": "Disabled / placeholder text (2.4:1)" }
      },
      "dark": {
        "primary": { "value": "#F5EDE2", "type": "color", "description": "Headings and code on dark (14.2:1 AAA)" },
        "secondary": { "value": "#C2BBB0", "type": "color", "description": "Secondary copy on dark (8.5:1 AAA)" },
        "muted": { "value": "#9E978D", "type": "color", "description": "Comments and line numbers on dark (5.1:1 AA)" },
        "subtle": { "value": "#706B62", "type": "color", "description": "Disabled text on dark (3.2:1)" }
      }
    },
    "accent": {
      "core": { "value": "#7790ED", "type": "color", "description": "Signature Periwinkle brand accent" },
      "strong": { "value": "#435DC9", "type": "color", "description": "Contrast-safe text link accent on light (4.6:1 AA)" },
      "hover": { "value": "#647EDD", "type": "color", "description": "Interactive accent hover" },
      "active": { "value": "#526DCF", "type": "color", "description": "Interactive accent active" },
      "wash-light": { "value": "rgba(119, 144, 237, 0.12)", "type": "color", "description": "Subtle tint on light" },
      "wash-dark": { "value": "rgba(119, 144, 237, 0.20)", "type": "color", "description": "Subtle tint on dark" }
    },
    "supporting": {
      "clay": { "value": "#C48248", "type": "color", "description": "Warm earth clay highlight (Light)" },
      "clay-dark": { "value": "#E09F67", "type": "color", "description": "Warm earth clay highlight (Dark)" }
    },
    "border": {
      "light": { "value": "rgba(41, 38, 33, 0.10)", "type": "color", "description": "Subtle border on light" },
      "light-strong": { "value": "rgba(41, 38, 33, 0.20)", "type": "color", "description": "Strong border on light" },
      "dark": { "value": "rgba(245, 237, 226, 0.12)", "type": "color", "description": "Subtle border on dark" },
      "dark-strong": { "value": "rgba(245, 237, 226, 0.22)", "type": "color", "description": "Strong border on dark" }
    },
    "semantic": {
      "success": { "value": "#2A7347", "darkValue": "#65C189", "type": "color", "description": "Success / Live indicator" },
      "warning": { "value": "#9A5B15", "darkValue": "#E8A34E", "type": "color", "description": "Warning / Expiry alert" },
      "error": { "value": "#B3392F", "darkValue": "#F06C62", "type": "color", "description": "Error / Destructive" },
      "info": { "value": "#435DC9", "darkValue": "#7790ED", "type": "color", "description": "Informational" }
    }
  }
}
