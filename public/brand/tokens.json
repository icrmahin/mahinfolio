{
  "$schema": "https://raw.githubusercontent.com/tokens-studio/figma-plugin/main/packages/tokens-studio-for-figma/src/schemas/tokens.json",
  "name": "icrmahin Signature Brand Color System",
  "version": "2.0.0",
  "author": "A. Mahin (icrmahin@gmail.com)",
  "description": "Eleven portable, contrast-audited color tokens with light and dark themes. These are the only colors used across icrmahin interfaces.",
  "color": {
    "page": {
      "light": { "value": "#f7f6f3", "type": "color", "description": "Primary canvas background" },
      "dark": { "value": "#14191b", "type": "color", "description": "Primary canvas background (dark)" }
    },
    "surface": {
      "light": { "value": "#ffffff", "type": "color", "description": "Elevated surfaces: cards, modals, code blocks" },
      "dark": { "value": "#1c2326", "type": "color", "description": "Elevated surfaces (dark)" }
    },
    "border": {
      "light": { "value": "#e3e1dc", "type": "color", "description": "Hairlines, dividers, structural outlines" },
      "dark": { "value": "#2e383c", "type": "color", "description": "Hairlines, dividers (dark)" }
    },
    "border-control": {
      "light": { "value": "#8c9699", "type": "color", "description": "Outlines for interactive controls" },
      "dark": { "value": "#5d6b70", "type": "color", "description": "Control outlines (dark)" }
    },
    "text": {
      "light": { "value": "#1f2a2e", "type": "color", "description": "Primary typography" },
      "dark": { "value": "#e9eeef", "type": "color", "description": "Primary typography (dark)" }
    },
    "text-muted": {
      "light": { "value": "#5c6b70", "type": "color", "description": "Secondary copy, metadata, labels" },
      "dark": { "value": "#9aa8ac", "type": "color", "description": "Secondary copy (dark)" }
    },
    "accent": {
      "light": { "value": "#2a7570", "type": "color", "description": "Primary actions, active and selected states" },
      "dark": { "value": "#6fbfb8", "type": "color", "description": "Accent (dark)" }
    },
    "accent-hover": {
      "light": { "value": "#1f5f5b", "type": "color", "description": "Hover and pressed accent states" },
      "dark": { "value": "#8fd3cd", "type": "color", "description": "Accent hover (dark)" }
    },
    "accent-soft": {
      "light": { "value": "#e3f0ee", "type": "color", "description": "Tinted backgrounds: badges, selections, washes" },
      "dark": { "value": "#1e3436", "type": "color", "description": "Tinted backgrounds (dark)" }
    },
    "accent-foreground": {
      "light": { "value": "#ffffff", "type": "color", "description": "Content on top of accent fills" },
      "dark": { "value": "#14191b", "type": "color", "description": "Content on accent fills (dark)" }
    },
    "focus": {
      "light": { "value": "#2a7570", "type": "color", "description": "Focus rings and outlines" },
      "dark": { "value": "#6fbfb8", "type": "color", "description": "Focus rings (dark)" }
    }
  },
  "rules": [
    "The system defines exactly eleven tokens; no other color value may appear in the codebase.",
    "State is carried by text and iconography, never by extra success/warning/error hues.",
    "Reference tokens through Tailwind utilities (bg-page, text-text, border-border) or var(--color-*).",
    "If a design needs a color outside the system, change the design or extend the token file."
  ]
}
